# ─── Environment ─────────────────────────────────────────────────────────────
# Which environment is active. Must be: development | production
APP_ENV=development

# ─── API ─────────────────────────────────────────────────────────────────────
# Full base URL of the backend server (no trailing slash)
# Dev example:  http://192.168.1.100:3000
# Prod example: https://api.yourdomain.com
API_BASE_URL=http://localhost:3000

# ─── Firebase Authentication ─────────────────────────────────────────────────
# Firebase config is bundled via google-services.json (Android) and
# GoogleService-Info.plist (iOS) — no key needed here.
