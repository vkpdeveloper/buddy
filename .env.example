# ─── Environment ─────────────────────────────────────────────────────────────
# Which environment is active. Must be: development | production
APP_ENV=development

# ─── API ─────────────────────────────────────────────────────────────────────
# Full base URL of the backend server (no trailing slash)
# Dev example:  http://192.168.1.100:3000
# Prod example: https://api.yourdomain.com
API_BASE_URL=http://localhost:3000

# ─── Clerk Authentication ─────────────────────────────────────────────────────
# Publishable key from https://dashboard.clerk.com → API Keys
# Dev keys start with pk_test_, prod keys with pk_live_
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
